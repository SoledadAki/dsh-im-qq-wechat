{
  "name": "dsh-im-qq-wechat",
  "version": "0.5.5",
  "description": "DeepSeek Harness Host plugin for QQ, WeChat, WeCom, Feishu and Telegram with persistent Agent sessions.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "sidecar/qq/*.mjs",
    "sidecar/weixin/*.mjs",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.json && esbuild src/client.tsx --loader:.tsx=tsx --jsx=transform --format=iife --target=es2022 --outfile=lib/client.js && node scripts/verify-client-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "pnpm run test:host && pnpm run test:sidecar",
    "test:host": "tsx --test test/*.test.ts",
    "test:sidecar": "node --test sidecar/qq/test/*.test.mjs sidecar/weixin/test/*.test.mjs",
    "prepack": "pnpm run typecheck && pnpm run test && pnpm run build",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "test:package": "node scripts/verify-package.mjs",
    "release:check": "pnpm pack --pack-destination dist && pnpm run test:package && pnpm run test:host-install",
    "test:host-install": "node scripts/verify-host.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.5-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.73.3",
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@tencent-connect/qqbot-nodejs": "1.0.4",
    "@wecom/aibot-node-sdk": "1.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@deepseek-ai/dsh": "0.1.5-rc.2"
  },
  "packageManager": "pnpm@11.19.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoledadAki/dsh-im-qq-wechat.git"
  },
  "bugs": {
    "url": "https://github.com/SoledadAki/dsh-im-qq-wechat/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "qq",
    "wechat",
    "wecom",
    "feishu",
    "telegram"
  ]
}
